---
# Copy this file to post_install_secrets.yaml (tracked, vault-encrypted --
# see docs/README_INSTALL_HUB.md Post-Openshift Install Setup step 1) and
# fill in real values, then encrypt with:
#   ansible-vault encrypt playbooks/vault/staging/post_install_secrets.yaml
github_client_id: '<GitHub OAuth app client ID>'
github_client_secret: '<GitHub OAuth app client secret>'
github_client_teams: '<comma-separated GitHub teams allowed to log in>'

aws_access_key_id: '<AWS access key ID for Route53>'
aws_secret_access_key: '<AWS secret access key for Route53>'
